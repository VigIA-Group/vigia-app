# ─────────────────────────────────────────────────────────────────
# VigIA App — Variables de entorno
# Copia este archivo como .env y rellena los valores
#
#   cp .env.example .env
#
# ⚠  Las variables EXPO_PUBLIC_* son visibles en el bundle de la app.
#    Nunca pongas claves secretas con el prefijo EXPO_PUBLIC_.
# ─────────────────────────────────────────────────────────────────

# ── Clerk (autenticación) ─────────────────────────────────────────
# Clerk Dashboard → API Keys → Publishable key  (empieza con pk_test_ o pk_live_)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REEMPLAZAR

# ── Supabase (base de datos directo) ──────────────────────────────
# Supabase Dashboard → Project Settings → API → Project URL
#   Ejemplo: https://<project-id>.supabase.co   (sin /rest/v1/ al final)
EXPO_PUBLIC_SUPABASE_URL=https://REEMPLAZAR.supabase.co

# Supabase Dashboard → Project Settings → API → Project API keys → anon / public
#   Empieza con eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REEMPLAZAR

# ── API Gateway (solo para onboarding y admin actions) ────────────
# Desarrollo local:   http://localhost:3000
# Producción:         https://api.vigia.world
EXPO_PUBLIC_API_URL=http://localhost:3000
