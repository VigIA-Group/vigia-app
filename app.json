{
  "expo": {
    "name": "VigIA",
    "slug": "vigia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/isotipo.png",
    "scheme": "vigia",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "notification": {
      "icon": "./assets/images/isotipo.png",
      "color": "#1d4ed8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "world.vigia.app",
      "infoPlist": {
        "NSCameraUsageDescription": "VigIA usa la cámara para capturar imágenes de cámaras de seguridad.",
        "NSMicrophoneUsageDescription": "VigIA puede capturar audio junto con video.",
        "NSPhotoLibraryUsageDescription": "VigIA guarda capturas en tu galería.",
        "NSFaceIDUsageDescription": "VigIA usa Face ID para autenticación biométrica.",
        "UIBackgroundModes": ["remote-notification", "fetch", "processing"]
      },
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/isotipo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "world.vigia.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/isotipo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo-dark.png",
          "imageWidth": 350,
          "resizeMode": "contain",
          "backgroundColor": "#020617",
          "dark": {
            "backgroundColor": "#020617"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/isotipo.png",
          "color": "#1d4ed8",
          "defaultChannel": "alerts",
          "sounds": []
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "VigIA usa la cámara para capturar imágenes.",
          "microphonePermission": "VigIA puede capturar audio junto con video.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "VigIA guarda capturas en tu galería.",
          "savePhotosPermission": "VigIA guarda capturas en tu galería.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "VigIA usa Face ID para autenticación biométrica."
        }
      ],
      "expo-sqlite",
      "expo-video",
      "expo-web-browser",
      "expo-background-fetch",
      "expo-task-manager",
      "@react-native-community/datetimepicker",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9e5ed94f-0835-4aca-b9fb-eec02f7ec7ec"
      }
    },
    "owner": "vigia.vision"
  }
}
